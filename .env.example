# 複製成 .env.local 後填入；全部留空也能跑，網站會使用內建的示範資料
# 部署到 Vercel 時在 Project Settings → Environment Variables 設定同樣的值

# 網站正式網址（OG 圖片、sitemap 用的絕對網址）
NEXT_PUBLIC_SITE_URL=https://your-project.vercel.app

# Supabase：Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# 只在伺服器使用（私有音檔 bucket、驗證後寫入報到紀錄），不可加 NEXT_PUBLIC_
SUPABASE_SERVICE_ROLE_KEY=

# 學員登入 cookie 的簽章金鑰，至少 32 個字元，只在伺服器使用，不可加 NEXT_PUBLIC_
# 產生方式：node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET=

# LINE Developers → LINE Login channel
NEXT_PUBLIC_LIFF_ID=
# 同一個 LINE Login channel 的 Channel ID，伺服器驗證 LIFF ID Token 用
LINE_LOGIN_CHANNEL_ID=
# 連結的 LINE 官方帳號 Basic ID（含 @），加好友提醒用
NEXT_PUBLIC_LINE_OA_ID=@your-oa-id

# 選用：活動消息改讀 Google 試算表（A 欄標題、B 欄內文、C 欄日期；要開「知道連結的任何人都能檢視」）
# 網址 https://docs.google.com/spreadsheets/d/{這一段}/edit 的中間那段；留空就顯示內建示範消息
NEWS_SHEET_ID=
NEWS_SHEET_GID=0
